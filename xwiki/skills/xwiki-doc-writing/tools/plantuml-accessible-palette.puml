skinparam ArrowColor #0568AE
' titleFontColor only: the nested `skinparam title { BackgroundColor }` form
' leaks its background onto every element in the diagram.
skinparam titleFontColor #0568AE
skinparam titleBorderColor #5A5A5A
' Links otherwise take bluegray's white root colour, unreadable on a light fill.
<style>
  root {
    HyperLinkColor #0568AE
  }
  element {
    HyperLinkColor #FFFFFF
  }
  actor, artifact, boundary, cloud, control, database, entity, file, folder, frame, interface,
  legend, node, package, rectangle {
    HyperLinkColor #0568AE
  }
</style>
' ---- end XWiki accessible diagram palette ----
