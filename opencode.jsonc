{
  // XWiki shared LLM configuration for opencode (https://opencode.ai).
  // version: 1.0.33 — keep in sync with the plugin version (see CLAUDE.md).
  //
  // Paths reference this checkout through the XWIKI_LLM_HOME environment variable so this file is
  // identical for everyone (no personal paths) and works whether it is used globally or per-project.
  // Set XWIKI_LLM_HOME to your xwiki-dev-llm checkout, e.g. in your shell profile:
  //   export XWIKI_LLM_HOME="$HOME/dev/xwiki/xwiki-dev-llm"
  // Skills are discovered separately (opencode only scans fixed directories) — see README.md.
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["{env:XWIKI_LLM_HOME}/xwiki/instructions/xwiki-org.md"],
  "mcp": {
    "discourse": {
      "type": "local",
      "command": ["npx", "-y", "@discourse/mcp@latest", "--site", "https://forum.xwiki.org"]
    },
    "sonarqube": {
      "type": "local",
      // Started via a Node wrapper (like Kimi Code) because opencode does not expand ${PWD} inside
      // an MCP command; the wrapper mounts the session's working directory into the Docker container.
      "command": ["node", "{env:XWIKI_LLM_HOME}/xwiki/scripts/start-sonarqube-mcp.mjs"],
      "environment": {
        "SONARQUBE_URL": "https://sonarcloud.io",
        "SONARQUBE_TOKEN": "{env:SONARQUBE_TOKEN}",
        "SONARQUBE_ORG": "xwiki",
        "SONARQUBE_PROJECT_KEY": "{env:SONARQUBE_PROJECT_KEY}",
        "SONARQUBE_TOOLSETS": "cag,projects,analysis,issues",
        "SONARQUBE_ADVANCED_ANALYSIS_ENABLED": "true"
      }
    }
  }
}
