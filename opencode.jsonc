{
  // XWiki shared LLM configuration for opencode (https://opencode.ai).
  // version: 1.17.13 — keep in sync with the plugin version (see CLAUDE.md).
  //
  // Paths reference this checkout through the XWIKI_LLM_HOME environment variable so this file is
  // identical for everyone (no personal paths) and works whether it is used globally or per-project.
  // Set XWIKI_LLM_HOME to your xwiki-dev-llm checkout, e.g. in your shell profile:
  //   export XWIKI_LLM_HOME="$HOME/dev/xwiki/xwiki-dev-llm"
  // Skills are discovered separately (opencode only scans fixed directories) — see README.md.
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["{env:XWIKI_LLM_HOME}/xwiki/instructions/xwiki-org.md"],
  "mcp": {
    "discourse": {
      "type": "local",
      // Started via a Node wrapper (like Claude Code and Kimi Code) so that the forum credential,
      // when set, is passed to the server in a temporary profile file and writes get enabled.
      "command": ["node", "{env:XWIKI_LLM_HOME}/xwiki/scripts/start-discourse-mcp.mjs"],
      "environment": {
        "DISCOURSE_API_KEY": "{env:DISCOURSE_API_KEY}",
        "DISCOURSE_API_USERNAME": "{env:DISCOURSE_API_USERNAME}",
        "DISCOURSE_USER_API_KEY": "{env:DISCOURSE_USER_API_KEY}",
        "DISCOURSE_USER_API_CLIENT_ID": "{env:DISCOURSE_USER_API_CLIENT_ID}"
      }
    },
    "develocity": {
      "type": "remote",
      // Develocity exposes MCP over streamable HTTP, so no local process is involved on any host.
      // opencode has no "read the bearer token from an env var" field (Kimi's bearerTokenEnvVar),
      // so the header is interpolated: with DEVELOCITY_MCP_ACCESS_KEY unset the server loads and every
      // request fails 401, rather than being skipped.
      "url": "https://community.develocity.cloud/mcp",
      "headers": {
        "Authorization": "Bearer {env:DEVELOCITY_MCP_ACCESS_KEY}"
      }
    },
    "sonarqube": {
      "type": "remote",
      // SonarSource's hosted server has no default organization, so SONARQUBE_ORG is required.
      "url": "https://api.sonarcloud.io/mcp",
      "headers": {
        "Authorization": "Bearer {env:SONARQUBE_TOKEN}",
        "SONARQUBE_ORG": "xwiki"
      }
    }
  }
}
