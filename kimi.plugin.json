{
  "name": "xwiki",
  "version": "1.17.15",
  "description": "Org-wide XWiki conventions, MCP servers and dev skills for all xwiki / xwiki-contrib GitHub org repos",
  "interface": {
    "displayName": "XWiki",
    "shortDescription": "XWiki org conventions, skills and MCP servers"
  },
  "skills": "./xwiki/skills/",
  "skillInstructions": "When a skill needs to locate the shared OKF knowledge base, resolve it relative to the skill file: `${KIMI_SKILL_DIR}/../../okf/`. In Claude Code the same location is `${CLAUDE_PLUGIN_ROOT}/okf/`.",
  "mcpServers": {
    "discourse": {
      "command": "node",
      "args": ["./xwiki/scripts/start-discourse-mcp.mjs"]
    },
    "develocity": {
      "url": "https://community.develocity.cloud/mcp",
      "bearerTokenEnvVar": "DEVELOCITY_MCP_ACCESS_KEY"
    },
    "sonarqube": {
      "url": "https://api.sonarcloud.io/mcp",
      "bearerTokenEnvVar": "SONARQUBE_TOKEN",
      "headers": {
        "SONARQUBE_ORG": "xwiki"
      }
    }
  },
  "hooks": [
    {
      "event": "SessionStart",
      "command": "node \"./xwiki/scripts/inject-org-instructions.mjs\""
    },
    {
      "event": "PostToolUse",
      "matcher": "Write|Edit",
      "command": "node \"./xwiki/scripts/check-line-endings.mjs\""
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "command": "node \"./xwiki/scripts/check-commit-text.mjs\""
    }
  ]
}
